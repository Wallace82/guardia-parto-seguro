# ============================================
# GUARDIA PARTO SEGURO — VARIÁVEIS DE AMBIENTE
# ============================================
# Copie este arquivo para .env e preencha com seus valores
# NUNCA commite o .env — ele já está no .gitignore

# ============ BANCO DE DADOS ============
DB_USER=guardia
DB_PASSWORD=guardia_dev_pass_CHANGE_ME
DB_NAME=guardia_db
DB_HOST=localhost
DB_PORT=5432
# URL completa usada pelos serviços dentro do Docker
DATABASE_URL=postgresql+asyncpg://guardia:guardia_dev_pass_CHANGE_ME@postgres-core:5432/core_db

# ============ REDIS ============
REDIS_PASSWORD=guardia_redis_pass_CHANGE_ME
REDIS_URL=redis://:guardia_redis_pass_CHANGE_ME@redis:6379/0

# ============ CORE API — JWT ============
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ AWS CONFIGURATION ============
AWS_ACCESS_KEY_ID=AKIAYIR5BL6JUFJA4KQF
AWS_SECRET_ACCESS_KEY= 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
AWS_REGION=us-east-1

# S3 Buckets
MEDIA_BUCKET_NAME=guardia-parto-seguro-media-dev
REPORTS_BUCKET_NAME=guardia-parto-seguro-reports-dev

# ============ URLS DOS SERVIÇOS (DOCKER) ============
VIDEO_SERVICE_URL=http://video-service:8001
AUDIO_SERVICE_URL=http://audio-service:8002
DOCUMENT_SERVICE_URL=http://document-service:8003
RISK_SERVICE_URL=http://risk-service:8004
REPORT_SERVICE_URL=http://report-service:8005

# ============ NOTIFICAÇÕES POR E-MAIL ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@guardia.health
SMTP_PASSWORD=your_smtp_password_here
ALERT_EMAIL_GESTOR=gestor@hospital.com
EMAIL_FROM_NAME=GuardIA Parto Seguro

# ============ CONFIGURAÇÃO GERAL ============
ENVIRONMENT=development
# Opções: development | staging | production
LOG_LEVEL=INFO
# Opções: DEBUG | INFO | WARNING | ERROR

# ============ IRA — PESOS (não alterar sem revisão técnica) ============
IRA_WEIGHT_VIDEO=0.40
IRA_WEIGHT_AUDIO=0.35
IRA_WEIGHT_DOCUMENT=0.25
IRA_THRESHOLD_MODERATE=40.0
IRA_THRESHOLD_CRITICAL=70.0

# ============ LIMITES DE UPLOAD ============
MAX_VIDEO_SIZE_MB=2000
MAX_AUDIO_SIZE_MB=500
MAX_DOCUMENT_SIZE_MB=50
MAX_VIDEOS_PER_SESSION=3
MAX_AUDIOS_PER_SESSION=3
MAX_DOCUMENTS_PER_SESSION=10

# ============ VIDEO ANALYSIS ============
VIDEO_FRAME_SAMPLE_RATE=1.0
# Frames por segundo a analisar (1.0 = 1 frame/segundo)
DEEPFACE_BACKEND=retinaface
# Opções: opencv | ssd | dlib | mtcnn | retinaface | mediapipe
YOLO_CONFIDENCE_THRESHOLD=0.70

# ============ FRONTEND ============
API_BASE_URL=http://localhost:8000
STREAMLIT_THEME=dark
